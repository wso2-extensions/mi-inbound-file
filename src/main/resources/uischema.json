              "name": "transport.vfs.ReconnectTimeout",
              "displayName": "Reconnect Timeout",
              "inputType": "string",
              "defaultValue": "30s",
              "required": "false",
              "helpTip": "The wait between two tries to reach the polled folder after a failure. A bare number below 1000 is in seconds, a bare number of 1000 or more is in milliseconds, and the suffix s or ms is taken as written."
